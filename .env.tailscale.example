# Copy this file to .env.tailscale and replace every placeholder locally.
# Never commit .env.tailscale or any real tailnet name or secret.
LOCKDIN_EXTERNAL_ORIGIN=https://windows-machine.example-tailnet.ts.net
LOCKDIN_TAILSCALE_EDGE_PORT=8088

POSTGRES_DB=lockedin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-the-existing-local-database-password
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-the-existing-keycloak-database-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-the-existing-admin-password
KEYCLOAK_API_CLIENT_SECRET=replace-with-the-existing-api-client-secret
KEYCLOAK_EVENT_WEBHOOK_SECRET=replace-with-the-existing-webhook-secret

# The base Compose file requires this value during interpolation. The Tailscale override removes
# the mount because backend-to-Keycloak traffic uses private Compose-network HTTP.
KEYCLOAK_CA_BUNDLE_HOST_PATH=C:/replace/with/existing/private/caddy-root-ca.crt
