APP_NAME=LockdIn Backend
APP_VERSION=0.1.0
DEBUG=true
CORS_ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Copy to backend/.env and use with:
# docker compose --env-file backend/.env up -d
# docker compose -f backend/docker-compose.yml --env-file backend/.env up -d

# Docker/backend runtime
BACKEND_PORT=8000
BACKEND_CONTAINER_PORT=8000
BIND=0.0.0.0:8000
WORKERS=1
WORKER_CLASS=uvicorn.workers.UvicornWorker
LOGLEVEL=info

# Postgres container exposed on host port 5433.
POSTGRES_DB=lockedin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# Local non-Docker backend connection URL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/lockedin

# Dockerized backend connecting to the separately-run database stack.
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:postgres@host.docker.internal:5433/lockedin

# Local Keycloak infrastructure. Replace both password placeholders before starting Compose.
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-local-random-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-different-local-random-password
MAILPIT_UI_PORT=8025

# Phase C OIDC contract. Generate independent random secrets; never commit real values.
# The full external origin has no trailing slash. The root Compose stack derives the issuer from it.
LOCKDIN_EXTERNAL_ORIGIN=https://192.168.2.44
KEYCLOAK_ISSUER=https://192.168.2.44/realms/lockdin
# Optional backend-to-Keycloak server URL. The Tailscale Compose override sets this internally.
KEYCLOAK_BACKCHANNEL_BASE_URL=
KEYCLOAK_MOBILE_CLIENT_ID=lockdin-mobile
KEYCLOAK_API_CLIENT_ID=lockdin-api
KEYCLOAK_API_CLIENT_SECRET=replace-with-a-random-introspection-client-secret
KEYCLOAK_REDIRECT_URI=com.lockdin.lockdinapp:/oauth2redirect
KEYCLOAK_EVENT_WEBHOOK_SECRET=replace-with-a-different-random-webhook-secret
# Absolute host path to the trusted Caddy root CA PEM. Do not place it in this repository.
KEYCLOAK_CA_BUNDLE_HOST_PATH=C:/replace/with/private/caddy-root-ca.crt
LOCKDIN_TAILSCALE_EDGE_PORT=8088
