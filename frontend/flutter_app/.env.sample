# Frontend API base URL override.
#
# Copy this file to `.env` and use the same value with Flutter's
# `--dart-define` or `--dart-define-from-file` workflow.
#
# Private Tailscale development edge. Replace both placeholders with the Windows node's
# full MagicDNS name. This remains reachable only while both devices are in the tailnet.
LOCKDIN_API_BASE_URL=https://windows-machine.example-tailnet.ts.net

# Optional one-time installation-binding migration. Set only to the exact issuer previously used
# by this installed app. Remove it from later builds after the migration has been verified.
# LOCKDIN_LEGACY_KEYCLOAK_ISSUER=https://127.0.0.1:8443/realms/lockdin

# Android emulator talking to a backend on your host machine:
# LOCKDIN_API_BASE_URL=http://10.0.2.2:8000

# Desktop/web talking to a backend on the same machine:
# LOCKDIN_API_BASE_URL=http://127.0.0.1:8000

# Example for a separately deployed backend:
# LOCKDIN_API_BASE_URL=https://api.example.com
