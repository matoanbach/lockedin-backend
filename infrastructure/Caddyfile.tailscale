{
	admin off
	auto_https off
}

:8080 {
	@keycloak path /realms/* /resources/* /.well-known/*
	handle @keycloak {
		reverse_proxy keycloak:8080 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}

	handle {
		reverse_proxy backend:8000 {
			header_up Host {http.request.host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
		}
	}
}
